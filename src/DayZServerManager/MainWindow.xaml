<Window x:Class="DayZServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DayZ Server Manager"
        Width="1280" Height="800" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Barre de titre ===== -->
            <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="pack://application:,,,/Assets/icon.png" Width="24" Height="24"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="DAYZ SERVER MANAGER" FontFamily="{StaticResource Orbitron}" FontSize="13"
                                   Foreground="{StaticResource TextBrush}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ChromeButton}" ToolTip="Réduire" Click="Minimize_Click">
                            <Path Data="M0,5 L10,5" StrokeThickness="1.2" Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" ToolTip="Agrandir" Click="Maximize_Click">
                            <Path Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" StrokeThickness="1.2" Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource CloseButton}" ToolTip="Fermer" Click="Close_Click">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.2" Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== Menu latéral ===== -->
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="12,20">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel2Brush}"
                                CornerRadius="10" Padding="14" Cursor="Hand"
                                ToolTip="Voir les mises à jour" MouseLeftButtonUp="Version_Click">
                            <StackPanel>
                                <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="BuildText" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"
                                           Foreground="{StaticResource CyanBrush}" />
                            </StackPanel>
                        </Border>

                        <StackPanel>
                            <TextBlock Text="MENU" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" Margin="12,0,0,10" />
                            <RadioButton Style="{StaticResource NavButton}" Content="Installation" Tag="install"
                                         IsChecked="True" Checked="Nav_Checked" />
                            <RadioButton Style="{StaticResource NavButton}" Content="Serveur" Tag="server"
                                         Checked="Nav_Checked" />
                            <RadioButton Style="{StaticResource NavButton}" Content="Configuration" Tag="config"
                                         Checked="Nav_Checked" />
                            <RadioButton Style="{StaticResource NavButton}" Content="Mods" Tag="mods"
                                         Checked="Nav_Checked" />
                            <RadioButton Style="{StaticResource NavButton}" Content="Pare-feu" Tag="firewall"
                                         Checked="Nav_Checked" />
                            <RadioButton Style="{StaticResource NavButton}" Content="Journaux" Tag="logs"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="UpdatesNav" Style="{StaticResource NavButton}" Content="Mises à jour"
                                         Tag="updates" Checked="Nav_Checked" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ===== Contenu de la page ===== -->
                <ContentControl x:Name="PageHost" Grid.Column="1" Margin="32,28" />
            </Grid>
        </Grid>
    </Border>
</Window>
