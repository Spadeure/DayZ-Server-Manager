<UserControl x:Class="DayZServerManager.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="JOURNAUX" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Lis les journaux du serveur en direct, sans fouiller dans les dossiers." FontSize="14"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- ===== Choix du journal ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <RadioButton x:Name="RptChip" Content="Serveur (RPT)" Tag="Rpt" GroupName="logkind"
                                     Style="{StaticResource ChipButton}" Height="38" Padding="14,0" Checked="Kind_Checked"
                                     ToolTip="Journal technique : erreurs, mods, crashs" />
                        <RadioButton x:Name="AdmChip" Content="Admin (ADM)" Tag="Adm" GroupName="logkind"
                                     Style="{StaticResource ChipButton}" Height="38" Padding="14,0" Checked="Kind_Checked"
                                     ToolTip="Connexions des joueurs, morts, tirs entre joueurs" />
                        <RadioButton x:Name="ScriptChip" Content="Scripts" Tag="Script" GroupName="logkind"
                                     Style="{StaticResource ChipButton}" Height="38" Padding="14,0" Checked="Kind_Checked"
                                     ToolTip="Erreurs des scripts des mods" />
                        <RadioButton x:Name="AppChip" Content="Application" Tag="App" GroupName="logkind"
                                     Style="{StaticResource ChipButton}" Height="38" Padding="14,0" Checked="Kind_Checked"
                                     ToolTip="Erreurs de Stryxhost Manager" />
                    </WrapPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Rechercher (joueur, message…)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}" FontFamily="Segoe UI" FontSize="13"
                                 Height="38" TextChanged="Search_TextChanged" />
                    </StackPanel>
                </Grid>

                <DockPanel Margin="0,14,0,0">
                    <WrapPanel DockPanel.Dock="Right">
                        <Button Content="Ouvrir le fichier" Style="{StaticResource SmallButton}" Click="OpenFile_Click" />
                        <Button Content="Ouvrir le dossier" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                Click="OpenFolder_Click" />
                    </WrapPanel>
                    <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="ErrorsText" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold"
                                   Margin="14,0,0,0" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="FileText" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ===== Contenu du journal ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource ConsoleBrush}" CornerRadius="10" Padding="14,10">
                    <ListBox x:Name="LinesList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontFamily="Consolas"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                        <CheckBox x:Name="FollowToggle" Content="Suivre en direct" Style="{StaticResource ToggleSwitch}"
                                  FontSize="13" IsChecked="True" />
                        <TextBlock x:Name="CountText" Style="{StaticResource MutedText}" Margin="16,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                        <CheckBox x:Name="CleanToggle" Content="Supprimer les journaux de plus de"
                                  ToolTip="Mets 0 pour supprimer tous les journaux"
                                  Style="{StaticResource ToggleSwitch}" FontSize="13" Click="CleanOptions_Changed" />
                        <TextBox x:Name="DaysBox" ToolTip="0 = tous les journaux" Style="{StaticResource NumberBox}" Width="56" MaxLength="3" Margin="10,0,6,0"
                                 LostFocus="CleanOptions_Changed" />
                        <TextBlock Text="jours" Foreground="{StaticResource MutedBrush}" FontSize="13"
                                   VerticalAlignment="Center" />
                        <Button Content="Nettoyer maintenant" Style="{StaticResource SmallButton}" Margin="12,0,0,0"
                                Click="CleanNow_Click" />
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
