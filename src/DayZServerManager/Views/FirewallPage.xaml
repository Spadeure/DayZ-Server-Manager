<UserControl x:Class="DayZServerManager.Views.FirewallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="PARE-FEU" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Ouvre les ports du serveur DayZ dans le pare-feu Windows." FontSize="14"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />

            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button x:Name="RecheckButton" DockPanel.Dock="Right" Content="Revérifier"
                                Style="{StaticResource SmallButton}" Click="Recheck_Click" />
                        <TextBlock Text="PORTS DU SERVEUR" Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Port de jeu" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="GameDesc" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBox x:Name="GamePortBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="110" MaxLength="5" Margin="12,0"
                                     TextChanged="Port_TextChanged" />
                            <Border x:Name="GamePill" Grid.Column="2" CornerRadius="12" Padding="10,4"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="GameStatus" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Port de requête Steam" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="QueryDesc" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBox x:Name="QueryPortBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="110" MaxLength="5" Margin="12,0"
                                     TextChanged="Port_TextChanged" />
                            <Border x:Name="QueryPill" Grid.Column="2" CornerRadius="12" Padding="10,4"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="QueryStatus" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Port RCon BattlEye" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="RconDesc" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBox x:Name="RconPortBox" Grid.Column="1" Style="{StaticResource NumberBox}" Width="110" MaxLength="5" Margin="12,0"
                                     TextChanged="Port_TextChanged" />
                            <Border x:Name="RconPill" Grid.Column="2" CornerRadius="12" Padding="10,4"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="RconStatus" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Programme du serveur" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="ProgramDesc" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border x:Name="ProgramPill" Grid.Column="2" CornerRadius="12" Padding="10,4"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="ProgramStatus" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="CloseButton" Content="Fermer les ports" Style="{StaticResource SecondaryButton}"
                                Click="Close_Click" />
                        <Button x:Name="OpenButton" Content="Ouvrir les ports" Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0" Click="Open_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="BON À SAVOIR" Style="{StaticResource SectionTitle}"
                               Foreground="{StaticResource CyanBrush}" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="0,10,0,0"
                               Text="Si le serveur tourne chez toi, il faut aussi ouvrir ces ports sur ta box internet (redirection de ports en UDP vers ce PC). Si le serveur est chez un hébergeur, le pare-feu Windows suffit." />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,0"
                               Text="Les numéros de ports choisis ici seront aussi utilisés pour la configuration du serveur." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
