<UserControl x:Class="DayZServerManager.Views.ServerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Petite étiquette au-dessus de chaque tuile -->
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileSub" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Text" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== En-tête ===== -->
        <DockPanel Grid.Row="0">
            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="StartButton" Content="Démarrer" Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,6" Click="Start_Click" />
                <Button x:Name="RestartButton" Content="Redémarrer" Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,6" Click="Restart_Click" />
                <Button x:Name="StopButton" Content="Arrêter" Style="{StaticResource SecondaryButton}"
                        Margin="10,0,0,6" Click="Stop_Click" />
                <Button x:Name="InstallButton" Content="Installer le serveur" Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,6" Click="Install_Click" />
            </WrapPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="TABLEAU DE BORD" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SubtitleText" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Tuiles ===== -->
        <Grid Grid.Row="1" Margin="0,22,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="ÉTAT" Style="{StaticResource TileLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse x:Name="StatusDot" Width="11" Height="11" VerticalAlignment="Center" Margin="0,2,9,0" />
                        <TextBlock x:Name="StatusText" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="UptimeText" Style="{StaticResource TileSub}" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="JOUEURS" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="PlayersValue" Text="—" Style="{StaticResource TileValue}" />
                    <ProgressBar x:Name="PlayersBar" Style="{StaticResource NeonProgress}" Height="6" Margin="0,8,0,0" />
                    <TextBlock x:Name="PlayersSub" Style="{StaticResource TileSub}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="PROCESSEUR" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="CpuValue" Text="—" Style="{StaticResource TileValue}" />
                    <ProgressBar x:Name="CpuBar" Style="{StaticResource NeonProgress}" Height="6" Margin="0,8,0,0" />
                    <TextBlock x:Name="CpuInfo" Style="{StaticResource TileSub}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="MÉMOIRE" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="RamValue" Text="—" Style="{StaticResource TileValue}" />
                    <ProgressBar x:Name="RamBar" Style="{StaticResource NeonProgress}" Height="6" Margin="0,8,0,0" />
                    <TextBlock x:Name="RamInfo" Style="{StaticResource TileSub}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Bas de page ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <!-- À surveiller -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="À SURVEILLER" Style="{StaticResource SectionTitle}" FontSize="13" />
                        <StackPanel x:Name="AlertsPanel" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Activité -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Dossier des journaux" Style="{StaticResource LinkButton}"
                                    Click="OpenLogs_Click" />
                            <TextBlock Text="ACTIVITÉ" Style="{StaticResource SectionTitle}" FontSize="13" />
                        </DockPanel>
                        <Border Grid.Row="1" Background="{StaticResource ConsoleBrush}" CornerRadius="10" Padding="12,10"
                                Margin="0,12,0,0">
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" LineHeight="19"
                                           TextWrapping="Wrap" Foreground="{StaticResource ConsoleTextBrush}" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Joueurs en ligne -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Voir tout →" Style="{StaticResource LinkButton}"
                                Click="AllPlayers_Click" />
                        <TextBlock Text="JOUEURS EN LIGNE" Style="{StaticResource SectionTitle}" FontSize="13" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PlayersPanel" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
