<UserControl x:Class="DayZServerManager.Views.ServerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="SERVEUR" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Démarre, arrête et surveille ton serveur DayZ." FontSize="14"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== État ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ÉTAT DU SERVEUR" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Ellipse x:Name="StatusDot" Width="14" Height="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" FontFamily="{StaticResource Orbitron}" FontSize="22"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="UptimeText" Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,0" />
                    <TextBlock x:Name="InfoText" Style="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,0" />
                    <TextBlock x:Name="PlayersText" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{StaticResource CyanBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="StartButton" Content="Démarrer" Style="{StaticResource PrimaryButton}"
                                Click="Start_Click" />
                        <Button x:Name="RestartButton" Content="Redémarrer" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Click="Restart_Click" />
                        <Button x:Name="StopButton" Content="Arrêter" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Click="Stop_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Options ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="REDÉMARRAGES" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="AutoRestartToggle" Content="Redémarrer tout seul en cas de crash"
                              Style="{StaticResource ToggleSwitch}" Margin="0,18,0,0" Click="Options_Changed" />
                    <CheckBox x:Name="ScheduledToggle" Content="Redémarrage programmé"
                              Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0" Click="Options_Changed" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Toutes les" Foreground="{StaticResource MutedBrush}" FontSize="13"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="HoursBox" Style="{StaticResource NumberBox}" Width="70" MaxLength="2" Margin="10,0"
                                 LostFocus="Hours_LostFocus" />
                        <TextBlock Text="heures" Foreground="{StaticResource MutedBrush}" FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox x:Name="WarnToggle" Content="Prévenir les joueurs 10, 5 et 1 min avant"
                              Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0" Click="Options_Changed" />
                    <TextBlock Text="Les redémarrages automatiques fonctionnent tant que l'application est ouverte."
                               Style="{StaticResource MutedText}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Ressources ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,20" Padding="20,16">
            <StackPanel>
                <TextBlock Text="RESSOURCES" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <DockPanel>
                            <TextBlock x:Name="CpuValue" DockPanel.Dock="Right" Text="—" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Processeur" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="utilisé par le serveur" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar x:Name="CpuBar" Style="{StaticResource NeonProgress}" Height="8" Margin="0,10,0,0" />
                        <TextBlock x:Name="CpuInfo" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <DockPanel>
                            <TextBlock x:Name="RamValue" DockPanel.Dock="Right" Text="—" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Mémoire" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="utilisée par le serveur" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar x:Name="RamBar" Style="{StaticResource NeonProgress}" Height="8" Margin="0,10,0,0" />
                        <TextBlock x:Name="RamInfo" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <DockPanel>
                            <TextBlock x:Name="DiskValue" DockPanel.Dock="Right" Text="—" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Disque" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="utilisé par le serveur" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar x:Name="DiskBar" Style="{StaticResource NeonProgress}" Height="8" Margin="0,10,0,0" />
                        <TextBlock x:Name="DiskInfo" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Journal ===== -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Paramètres de lancement" Style="{StaticResource SmallButton}"
                                Click="LaunchSettings_Click" />
                        <Button Content="Dossier des journaux" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                Click="OpenLogs_Click" />
                    </StackPanel>
                    <TextBlock Text="ACTIVITÉ" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <Border Grid.Row="1" Background="{StaticResource ConsoleBrush}" CornerRadius="10" Padding="14"
                        Margin="0,14,0,0">
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" LineHeight="20"
                                   TextWrapping="Wrap" Foreground="{StaticResource ConsoleTextBrush}" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
