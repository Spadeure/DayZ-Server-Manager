<UserControl x:Class="DayZServerManager.Views.XmlEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ÉDITEUR XML" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Ouvre et modifie n'importe quel fichier XML du serveur ou d'un mod." FontSize="14"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- ===== Choix du fichier ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,20" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Chemin du fichier" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Style="{StaticResource FieldBox}" Height="40" KeyDown="PathBox_KeyDown" />
                    <Button Grid.Column="1" Content="Parcourir" Style="{StaticResource SecondaryButton}" Height="40"
                            Margin="8,0,0,0" Click="Browse_Click" />
                    <Button Grid.Column="2" Content="Ouvrir" Style="{StaticResource PrimaryButton}" Height="40"
                            Margin="8,0,0,0" Click="OpenPath_Click" />
                </Grid>
                <TextBlock x:Name="QuickTitle" Text="Fichiers de la mission" Style="{StaticResource MutedText}"
                           Margin="0,12,0,6" />
                <WrapPanel x:Name="QuickPanel" />
            </StackPanel>
        </Border>

        <!-- ===== Éditeur ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right">
                        <Button Content="Rechercher (Ctrl+F)" Style="{StaticResource SmallButton}" Margin="8,0,0,6"
                                Click="Search_Click" />
                        <Button Content="Vérifier" Style="{StaticResource SmallButton}" Margin="8,0,0,6"
                                Click="Check_Click" />
                        <Button Content="Recharger" Style="{StaticResource SmallButton}" Margin="8,0,0,6"
                                Click="Reload_Click" />
                        <Button x:Name="SaveButton" Content="Enregistrer (Ctrl+S)" Style="{StaticResource PrimaryButton}"
                                Height="32" FontSize="12" Padding="14,0" Margin="8,0,0,6" Click="Save_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="FileTitle" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,12,6" />
                </DockPanel>

                <Border Grid.Row="1" Background="{StaticResource ConsoleBrush}" CornerRadius="10" Padding="4,8"
                        Margin="0,8,0,0">
                    <ae:TextEditor x:Name="Editor" FontFamily="Consolas" FontSize="13" ShowLineNumbers="True"
                                   Background="Transparent" Foreground="{StaticResource ConsoleTextBrush}"
                                   LineNumbersForeground="{StaticResource MutedBrush}" WordWrap="False"
                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Border>

                <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
