<UserControl x:Class="DayZServerManager.Views.PlayersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="JOUEURS" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Administre ton serveur à distance grâce au RCon de BattlEye." FontSize="14"
                           Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Border x:Name="StatusPill" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <Button x:Name="ConnectButton" Content="Se connecter" Style="{StaticResource SmallButton}"
                        Margin="10,0,0,0" Click="Connect_Click" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Message à tous ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,20" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Message à tous les joueurs" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                    <TextBox x:Name="BroadcastBox" Style="{StaticResource FieldBox}" FontFamily="Segoe UI" FontSize="14"
                             MaxLength="200" KeyDown="BroadcastBox_KeyDown" />
                </StackPanel>
                <Button Grid.Column="1" Content="Envoyer" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        VerticalAlignment="Bottom" Click="Broadcast_Click" />
            </Grid>
        </Border>

        <!-- ===== Listes ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Actualiser"
                            Style="{StaticResource SmallButton}" VerticalAlignment="Center" Click="Refresh_Click" />
                    <WrapPanel>
                        <RadioButton x:Name="OnlineTab" Content="En ligne" GroupName="playertabs" Tag="online"
                                     Style="{StaticResource ChipButton}" Height="36" Padding="14,0" Checked="Tab_Checked" />
                        <RadioButton x:Name="BansTab" Content="Bannis" GroupName="playertabs" Tag="bans"
                                     Style="{StaticResource ChipButton}" Height="36" Padding="14,0" Checked="Tab_Checked" />
                        <RadioButton x:Name="WhitelistTab" Content="Whitelist" GroupName="playertabs" Tag="whitelist"
                                     Style="{StaticResource ChipButton}" Height="36" Padding="14,0" Checked="Tab_Checked" />
                        <RadioButton x:Name="PriorityTab" Content="File prioritaire" GroupName="playertabs" Tag="priority"
                                     Style="{StaticResource ChipButton}" Height="36" Padding="14,0" Checked="Tab_Checked" />
                    </WrapPanel>
                </DockPanel>

                <!-- Ajout d'un SteamID (whitelist et file prioritaire) -->
                <StackPanel x:Name="AddPanel" Grid.Row="1" Margin="0,14,0,0" Visibility="Collapsed">
                    <CheckBox x:Name="WhitelistToggle" Content="Activer la whitelist (seuls les joueurs de la liste peuvent rejoindre)"
                              Style="{StaticResource ToggleSwitch}" Margin="0,0,0,12" Click="WhitelistToggle_Click" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SteamID64 (17 chiffres, commence par 7656…)" Style="{StaticResource MutedText}"
                                       Margin="0,0,0,4" />
                            <TextBox x:Name="SteamIdBox" Style="{StaticResource FieldBox}" Height="40" MaxLength="17" Tag="number" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nom (pour t'y retrouver)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox x:Name="SteamNameBox" Style="{StaticResource FieldBox}" Height="40" FontFamily="Segoe UI"
                                     FontSize="14" MaxLength="40" />
                        </StackPanel>
                        <Button Grid.Column="3" Content="Ajouter" Style="{StaticResource PrimaryButton}" Height="40"
                                Margin="10,0,0,0" VerticalAlignment="Bottom" Click="AddSteamId_Click" />
                    </Grid>
                </StackPanel>

                <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ListPanel" />
                </ScrollViewer>

                <TextBlock x:Name="InfoText" Grid.Row="3" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
