<Window x:Class="DayZServerManager.Views.BanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stryxhost Manager" Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Border BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" Padding="28"
            Background="{StaticResource PanelBrush}" MouseLeftButtonDown="Window_Drag">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Style="{StaticResource SectionTitle}" FontSize="18"
                       Foreground="{StaticResource WarnBrush}" />
            <TextBlock Text="Durée du bannissement" Style="{StaticResource MutedText}" Margin="0,18,0,8" />
            <WrapPanel>
                <RadioButton x:Name="HourChip" Content="1 heure" GroupName="duration" Style="{StaticResource ChipButton}"
                             Height="38" Padding="12,0" />
                <RadioButton x:Name="DayChip" Content="24 heures" GroupName="duration" Style="{StaticResource ChipButton}"
                             Height="38" Padding="12,0" />
                <RadioButton x:Name="WeekChip" Content="7 jours" GroupName="duration" Style="{StaticResource ChipButton}"
                             Height="38" Padding="12,0" />
                <RadioButton x:Name="PermChip" Content="Définitif" GroupName="duration" Style="{StaticResource ChipButton}"
                             Height="38" Padding="12,0" IsChecked="True" />
            </WrapPanel>
            <TextBlock Text="Raison (affichée au joueur)" Style="{StaticResource MutedText}" Margin="0,16,0,6" />
            <TextBox x:Name="ReasonBox" Style="{StaticResource FieldBox}" FontFamily="Segoe UI" FontSize="14"
                     MaxLength="120" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True" />
                <Button Content="Bannir" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
