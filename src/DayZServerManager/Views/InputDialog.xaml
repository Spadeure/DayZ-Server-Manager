<Window x:Class="DayZServerManager.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DayZ Server Manager" Width="420" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="28"
            Background="{StaticResource PanelBrush}" MouseLeftButtonDown="Window_Drag">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Style="{StaticResource SectionTitle}" FontSize="18" />
            <TextBlock x:Name="MessageText" Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,18" />
            <TextBox x:Name="ValueBox" Style="{StaticResource FieldBox}" FontSize="22" Height="52"
                     HorizontalContentAlignment="Center" CharacterCasing="Upper" MaxLength="10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True" />
                <Button Content="Valider" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
