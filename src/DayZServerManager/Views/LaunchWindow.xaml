<Window x:Class="DayZServerManager.Views.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres de lancement" Width="680" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="28"
            Background="{StaticResource PanelBrush}" MouseLeftButtonDown="Window_Drag">
        <StackPanel>
            <TextBlock Text="PARAMÈTRES DE LANCEMENT" Style="{StaticResource SectionTitle}" FontSize="18" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,0"
                       Text="La ligne de commande utilisée pour démarrer le serveur. Les changements s'appliquent au prochain démarrage." />

            <!-- Aperçu -->
            <DockPanel Margin="0,18,0,6">
                <Button DockPanel.Dock="Right" Content="Copier" Style="{StaticResource SmallButton}" Click="Copy_Click" />
                <TextBlock Text="Ligne qui sera utilisée" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            </DockPanel>
            <Border Background="{StaticResource ConsoleBrush}" CornerRadius="10" Padding="14,12">
                <TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="12" LineHeight="19" TextWrapping="Wrap"
                           Foreground="{StaticResource ConsoleTextBrush}" />
            </Border>

            <!-- Mods ajoutés à la main -->
            <DockPanel Margin="0,16,0,0">
                <Button DockPanel.Dock="Right" Content="Détecter les mods ajoutés à la main" Style="{StaticResource SmallButton}"
                        Click="Detect_Click" />
                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"
                           Text="Tu as copié un mod (@…) toi-même dans le dossier du serveur ? Ajoute-le à la liste des mods." />
            </DockPanel>

            <!-- Paramètres en plus -->
            <StackPanel x:Name="ExtraPanel" Margin="0,18,0,0">
                <TextBlock Text="Paramètres supplémentaires (ajoutés à la fin, ex. : -cpuCount=4 -limitFPS=60)"
                           Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                <TextBox x:Name="ExtraBox" Style="{StaticResource FieldBox}" TextChanged="Text_Changed" />
            </StackPanel>

            <!-- Ligne personnalisée -->
            <CheckBox x:Name="CustomToggle" Content="Écrire toute la ligne moi-même" Style="{StaticResource ToggleSwitch}"
                      Margin="0,18,0,0" Click="Custom_Click" />
            <StackPanel x:Name="CustomPanel" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource MutedText}" Foreground="{StaticResource WarnBrush}" Margin="0,0,0,6"
                           Text="Attention : dans ce mode, l'onglet Mods et les ports du pare-feu ne modifient plus la ligne. C'est toi qui gères tout." />
                <TextBox x:Name="CustomBox" Style="{StaticResource FieldBox}" Height="96" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Padding="10,8" TextChanged="Text_Changed" />
                <Button Content="Repartir de la ligne automatique" Style="{StaticResource SmallButton}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="Reset_Click" />
            </StackPanel>

            <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True" />
                <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
