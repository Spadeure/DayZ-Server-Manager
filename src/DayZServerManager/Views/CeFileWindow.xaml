<Window x:Class="DayZServerManager.Views.CeFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fichier d'économie" Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="28"
            Background="{StaticResource PanelBrush}" MouseLeftButtonDown="Window_Drag">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Style="{StaticResource SectionTitle}" FontSize="18" />
            <TextBlock x:Name="SubText" Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,0" />

            <StackPanel x:Name="NamePanel" Margin="0,18,0,0" Visibility="Collapsed">
                <TextBlock Text="Nom du fichier (ex. : morefood_types.xml)" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" FontFamily="Segoe UI" FontSize="14" MaxLength="80" />
            </StackPanel>

            <TextBlock Text="Type de fichier (ce que le serveur doit en faire)" Style="{StaticResource MutedText}" Margin="0,18,0,8" />
            <StackPanel x:Name="TypesPanel" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap"
                       Margin="0,10,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True" />
                <Button x:Name="OkButton" Content="Valider" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
