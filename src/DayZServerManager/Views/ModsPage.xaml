<UserControl x:Class="DayZServerManager.Views.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="MODS" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Cherche un mod du Steam Workshop et installe-le sur ton serveur en un clic." FontSize="14"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- ===== Recherche ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}" FontFamily="Segoe UI" FontSize="14"
                             KeyDown="SearchBox_KeyDown" />
                    <Button x:Name="SearchButton" Grid.Column="1" Content="Rechercher" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Click="Search_Click" />
                </Grid>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                           Text="Tape le nom d'un mod (ex. : Expansion, CF, Trader…), ou colle directement son lien du Workshop." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Résultats / Installés ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <Button x:Name="UpdateAllButton" DockPanel.Dock="Right" Content="Mettre à jour tous les mods"
                                Style="{StaticResource SmallButton}" VerticalAlignment="Center" Click="UpdateAll_Click" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ResultsTab" Content="Résultats" GroupName="modtabs"
                                         Style="{StaticResource ChipButton}" Height="36" Padding="14,0" Checked="Tab_Checked" />
                            <RadioButton x:Name="InstalledTab" Content="Installés" GroupName="modtabs"
                                         Style="{StaticResource ChipButton}" Height="36" Padding="14,0" Checked="Tab_Checked" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer x:Name="ResultsScroll" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ResultsList" />
                    </ScrollViewer>
                    <ScrollViewer x:Name="InstalledScroll" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <StackPanel x:Name="ModsList" />
                    </ScrollViewer>

                    <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                </Grid>
            </Border>

            <!-- ===== Journal ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ACTIVITÉ" Style="{StaticResource SectionTitle}" />
                    <Border Grid.Row="1" Background="{StaticResource ConsoleBrush}" CornerRadius="10" Padding="14"
                            Margin="0,14,0,0">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" LineHeight="20"
                                       TextWrapping="Wrap" Foreground="{StaticResource ConsoleTextBrush}" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
