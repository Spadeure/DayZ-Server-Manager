<UserControl x:Class="DayZServerManager.Views.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="MODS" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Installe les mods du Steam Workshop sur ton serveur, avec leurs clés." FontSize="14"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- ===== Ajouter ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,20">
            <StackPanel>
                <TextBlock Text="AJOUTER UN MOD" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Colle le lien du mod sur le Steam Workshop, ou son numéro."
                           Style="{StaticResource MutedText}" Margin="0,14,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ModInput" Style="{StaticResource FieldBox}" FontFamily="Segoe UI" FontSize="14" />
                    <Button x:Name="AddButton" Grid.Column="1" Content="Ajouter" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Click="Add_Click" />
                </Grid>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                           Text="Exemple : https://steamcommunity.com/sharedfiles/filedetails/?id=1559212036" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Liste ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button x:Name="UpdateAllButton" DockPanel.Dock="Right" Content="Mettre à jour tous les mods"
                                Style="{StaticResource SmallButton}" Click="UpdateAll_Click" />
                        <TextBlock x:Name="ListTitle" Text="MODS INSTALLÉS" Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ModsList" />
                    </ScrollViewer>
                    <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                </Grid>
            </Border>

            <!-- ===== Journal ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ACTIVITÉ" Style="{StaticResource SectionTitle}" />
                    <Border Grid.Row="1" Background="{StaticResource ConsoleBrush}" CornerRadius="10" Padding="14"
                            Margin="0,14,0,0">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" LineHeight="20"
                                       TextWrapping="Wrap" Foreground="{StaticResource ConsoleTextBrush}" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
