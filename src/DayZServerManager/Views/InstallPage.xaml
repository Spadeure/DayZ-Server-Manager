<UserControl x:Class="DayZServerManager.Views.InstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== En-tête ===== -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="INSTALLATION DU SERVEUR" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Prépare un serveur DayZ complet en quatre étapes." FontSize="14"
                           Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" VerticalAlignment="Bottom" Background="{StaticResource Panel2Brush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="12,6">
                <TextBlock x:Name="StepBadge" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" />
            </Border>
        </DockPanel>

        <!-- ===== Étapes ===== -->
        <UniformGrid x:Name="StepsGrid" Grid.Row="1" Columns="4" Margin="0,20,0,20" />

        <!-- ===== Contenu ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DOSSIER D'INSTALLATION" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="SteamCMD et les fichiers serveur seront placés dans ce dossier."
                                   Style="{StaticResource MutedText}" Margin="0,14,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderBox" Style="{StaticResource FieldBox}" IsReadOnly="True" />
                            <Button x:Name="BrowseButton" Grid.Column="1" Content="Parcourir" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="Browse_Click" />
                        </Grid>
                        <TextBlock x:Name="SpaceText" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="20,20,20,8">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="RecheckButton" DockPanel.Dock="Right" Content="Revérifier" Style="{StaticResource SmallButton}"
                                    Click="Recheck_Click" />
                            <Button x:Name="InstallDepsButton" DockPanel.Dock="Right" Content="Installer"
                                    Style="{StaticResource SmallButton}" Margin="0,0,8,0" Visibility="Collapsed"
                                    Click="InstallDeps_Click" />
                            <TextBlock Text="DÉPENDANCES" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel x:Name="DepsPanel" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="FICHIERS SERVEUR DAYZ" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="AppInfoText" Text="Téléchargement via SteamCMD"
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <DockPanel>
                            <TextBlock x:Name="PercentText" Text="0 %" FontFamily="Segoe UI" FontWeight="Bold"
                                       FontSize="32" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="ProgressInfo" Text="En attente" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </DockPanel>
                        <ProgressBar x:Name="Progress" Style="{StaticResource NeonProgress}" Value="0"
                                     Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Grid.Row="2" Background="{StaticResource ConsoleBrush}" CornerRadius="10"
                            Padding="14" Margin="0,16,0,16">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" LineHeight="20"
                                       TextWrapping="Wrap" Foreground="{StaticResource ConsoleTextBrush}" />
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="StartButton" Content="Lancer l'installation"
                                Style="{StaticResource PrimaryButton}" Click="Start_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
