<Window x:Class="DayZServerManager.Views.SteamLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion Steam" Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="28"
            Background="{StaticResource PanelBrush}" MouseLeftButtonDown="Window_Drag">
        <StackPanel>
            <TextBlock Text="CONNEXION STEAM" Style="{StaticResource SectionTitle}" FontSize="18" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,20"
                       Text="Les fichiers serveur DayZ se téléchargent avec un compte Steam qui possède DayZ. Ton mot de passe n'est jamais enregistré par l'application." />

            <TextBlock Text="Nom d'utilisateur Steam" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
            <TextBox x:Name="UserBox" Style="{StaticResource FieldBox}" FontFamily="Segoe UI" FontSize="14" />

            <TextBlock Text="Mot de passe" Style="{StaticResource MutedText}" Margin="0,16,0,6" />
            <PasswordBox x:Name="PassBox" Style="{StaticResource FieldPassword}" />

            <Border Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="14" Margin="0,20,0,0">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           Text="Après avoir cliqué sur « Se connecter », accepte la demande dans l'application Steam de ton téléphone. Si un code est demandé, une fenêtre s'ouvrira pour le saisir." />
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource WarnBrush}" FontSize="12"
                       Margin="0,12,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True" />
                <Button Content="Se connecter" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
